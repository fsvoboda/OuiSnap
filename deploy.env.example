# Modèle de configuration de mise en ligne. Copier en .env.deploy (non versionné)
# et renseigner les valeurs entre apostrophes.

# --- Accès FTP (espace client OVH > Hébergements > onglet « FTP - SSH ») ---
OVH_FTP_HOST='ftp.clusterXXX.hosting.ovh.net'
OVH_FTP_USER=''
OVH_FTP_PASSWORD=''
# sftp (chiffré, recommandé) ou ftp
OVH_PROTOCOL='sftp'
# Dossier du site, relatif à la racine FTP
OVH_REMOTE_DIR='ouisnap'

# --- Base MySQL (onglet « Bases de données ») ---
DB_HOST=''
DB_NAME=''
DB_USER=''
DB_PASSWORD=''

# Adresse publique du site (utilisée pour lancer les migrations SQL)
OVH_SITE_URL='https://exemple.fr'

# Mot de passe de la page d'administration (/admin/)
ADMIN_PASSWORD=''

# Adresse d'expédition des e-mails envoyés aux photographes
MAIL_FROM=''
