# Modèle de configuration de mise en ligne. Copier en .env.deploy (non versionné)
# et renseigner les valeurs entre apostrophes.

# --- Accès FTP (espace client OVH > Hébergements > onglet « FTP - SSH ») ---
OVH_FTP_HOST='ftp.clusterXXX.hosting.ovh.net'
OVH_FTP_USER=''
OVH_FTP_PASSWORD=''
# sftp (chiffré, recommandé) ou ftp
OVH_PROTOCOL='sftp'
# Dossier du site, relatif à la racine FTP
OVH_REMOTE_DIR='ouisnap'

# --- Base MySQL (onglet « Bases de données ») ---
DB_HOST=''
DB_NAME=''
DB_USER=''
DB_PASSWORD=''

# Adresse publique du site (obligatoire : utilisée pour lancer les migrations SQL et pour les liens des e-mails)
OVH_SITE_URL='https://exemple.fr'

# Mot de passe initial de la page d'administration (/admin/). Ignoré dès qu'un mot de passe
# a été choisi avec « Mot de passe oublié ? ».
ADMIN_PASSWORD=''

# Adresses qui reçoivent le lien de réinitialisation du mot de passe, séparées par des virgules
# (obligatoire, adresses réelles) : a@domaine.fr,b@domaine.fr
ADMIN_EMAILS=''

# Adresse d'expédition des e-mails (photographes, lien de réinitialisation). Obligatoire.
MAIL_FROM=''
