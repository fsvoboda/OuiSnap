# Fichiers internes de l'API : inclus par les autres scripts, jamais appelés depuis le web.
<FilesMatch "^(config|config\.example|lib|mail|retention)\.php$">
  Require all denied
</FilesMatch>

# Réglages PHP du dossier : lus par le serveur, jamais servis au navigateur.
<FilesMatch "^\.user\.ini$">
  Require all denied
</FilesMatch>
